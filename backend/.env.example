# Copy this file to ".env" and fill in your actual local values.
# Never commit the real ".env" file to version control.

# Postgres connection — update <your_password> with what you set during install
DATABASE_URL=postgresql+psycopg2://postgres:<your_password>@localhost:5432/docflow_ai

# Groq API key (for later phases — LLM calls). Leave blank for now if not needed yet.
GROQ_API_KEY=

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret for Session Cookies (Change this in production!)
JWT_SECRET=super-secret-key-change-in-prod

# Max upload size in bytes (10MB, per Phase 1 decision — temporary, blob-era limit)
MAX_UPLOAD_SIZE_BYTES=10485760
